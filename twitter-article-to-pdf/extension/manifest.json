{
  "manifest_version": 3,
  "name": "X Article to PDF",
  "version": "1.1.0",
  "description": "One click from an X (Twitter) Article to a PDF for reading: pictures, equations, code and links are kept. Also exports the LaTeX source.",
  "key": "",
  "action": { "default_title": "Convert this X Article to PDF" },
  "background": { "service_worker": "background.js" },
  "permissions": ["activeTab", "debugger"],
  "host_permissions": [
    "https://api.fxtwitter.com/*",
    "https://pbs.twimg.com/*",
    "http://127.0.0.1/*"
  ],
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self'"
  }
}
