{
  "manifest_version": 3,
  "name": "X Article to LaTeX PDF",
  "version": "1.0.0",
  "description": "Turn an X (Twitter) Article into a LaTeX document and a PDF for reading: pictures, equations, code and links are kept.",
  "key": "",
  "action": { "default_title": "Convert this X Article to LaTeX / PDF" },
  "background": { "service_worker": "background.js" },
  "permissions": ["activeTab"],
  "host_permissions": [
    "https://api.fxtwitter.com/*",
    "https://pbs.twimg.com/*",
    "http://127.0.0.1/*"
  ],
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self'"
  }
}
